# ─────────────────────────────────────────────────────────────────────────────
# Digital Twin AI – Environment Variables Template
# Copy this to .env and fill in real values. Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose (async): postgresql+asyncpg://postgres:<PASSWORD>@db:5432/digital_twin
# Local Postgres  (async): postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/digital_twin
# SQLite fallback (testing): sqlite+aiosqlite:///./digital_twin.db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/digital_twin

# Sync URL used by Alembic migrations and ml/ingest.py (psycopg2 driver)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/digital_twin

# ─── Security & Authentication ───────────────────────────────────────────────
# Generate a secure random secret (minimum 32 characters):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Requests per minute per IP for auth and chat endpoints
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_CHAT_PER_MINUTE=25

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Google Gemini API ───────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
# Key is read from .env only — never hardcoded anywhere in source code.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── LLM Provider Chain & Resilience ───────────────────────────────────────────
LLM_PROVIDER_CHAIN=gemini,openai_compatible,offline
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
DEMO_MODE=false

# ─── Demo Account & Login ────────────────────────────────────────────────────
# Enable one-click demo login endpoint on /api/v1/auth/demo-login
ENABLE_DEMO_LOGIN=false

# ─── Frontend ────────────────────────────────────────────────────────────────
# Public URL of the FastAPI backend (accessible by the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

