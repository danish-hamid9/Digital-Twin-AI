# Database Configuration
# For Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/digital_twin
# For Local Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin
# For Local SQLite (Fallback/Testing): sqlite+aiosqlite:///./digital_twin.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/digital_twin

# Security & Authentication
JWT_SECRET=replace_with_a_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API (Read from .env only, no hardcoded models)
# Default free-tier Flash model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
